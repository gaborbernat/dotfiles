#!/bin/bash
# duti config hash: {{ include "dot_duti" | sha256sum }}
set -euo pipefail

if command -v duti >/dev/null 2>&1; then
    echo "Setting file associations..."
    duti "${HOME}/.duti"
    echo "File associations applied"
else
    echo "duti is required to apply file associations" >&2
    exit 1
fi
