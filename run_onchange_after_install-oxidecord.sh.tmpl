{{- if ne (env "SKIP_DNF_INSTALL") "1" -}}
#!/bin/bash
# Oxidecord updater hash: {{ include "dot_local/bin/executable_update_fedora_extras.tmpl" | sha256sum }}
# Oxidecord patch hash: {{ include "scripts/fedora/oxidecord-capture-name.diff" | sha256sum }}
set -euo pipefail

export PATH="${HOME}/.cargo/bin:${PATH}"
"${HOME}/.local/bin/update_fedora_extras" oxidecord
if flatpak info app.legcord.Legcord >/dev/null 2>&1; then
    sudo flatpak uninstall --system -y app.legcord.Legcord
fi
{{ end -}}
