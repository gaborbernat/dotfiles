{{ if and (eq .chezmoi.os "darwin") (stat "/Volumes/OWC") -}}
#!/bin/bash
# The 229 GB internal disk fills up from toolchains and caches, so they live on the external volume and the home
# paths are symlinks to it. This runs before the rustup bootstrap so a fresh machine installs into the link, not a
# real ~/.cargo.
set -euo pipefail

external=/Volumes/OWC

link() {
    local home_path="$1" target="$2"
    if [ -L "$home_path" ]; then
        return
    fi
    mkdir -p "$target" "$(dirname "$home_path")"
    # A real directory keeps its contents: they move to the external copy before it is replaced.
    if [ -d "$home_path" ]; then
        cp -Rp "$home_path/." "$target/"
        rm -rf "$home_path"
    fi
    ln -s "$target" "$home_path"
    echo "linked $home_path -> $target"
}

link_file() {
    local home_path="$1" target="$2"
    if [ -L "$home_path" ]; then
        return
    fi
    mkdir -p "$(dirname "$target")"
    # The -wal and -shm siblings belong to the same database and follow it.
    for suffix in "" -wal -shm; do
        if [ -f "$home_path$suffix" ]; then
            mv "$home_path$suffix" "$target$suffix"
            ln -s "$target$suffix" "$home_path$suffix"
            echo "linked $home_path$suffix -> $target$suffix"
        fi
    done
}

link "$HOME/.rustup" "$external/.rustup"
link "$HOME/.cargo" "$external/.cargo"
link "$HOME/.cache" "$external/.cache"
link "$HOME/.npm" "$external/caches/npm"
link "$HOME/.gradle" "$external/caches/gradle"
link "$HOME/Library/Caches/Homebrew" "$external/caches/homebrew"
link "$HOME/Library/Caches/pip" "$external/caches/pip"
link "$HOME/Library/Caches/grype" "$external/caches/grype"
link "$HOME/Library/Caches/ms-playwright" "$external/caches/ms-playwright"
link "$HOME/.local/share/uv/python" "$external/caches/uv/python"
link "$HOME/.local/share/uv/tools" "$external/caches/uv/tools"
link "$HOME/.local/share/mise/installs" "$external/caches/mise/installs"
link "$HOME/.local/share/mise/http-tarballs" "$external/caches/mise/http-tarballs"
link "$HOME/Library/Developer/Toolchains" "$external/developer/Toolchains"
link "$HOME/.codex/sessions" "$external/caches/codex/sessions"

# Codex keeps its transcripts and logs in SQLite beside its config, so the files
# move individually; the config itself stays managed by chezmoi.
link_file "$HOME/.codex/thread_history_1.sqlite" "$external/caches/codex/thread_history_1.sqlite"
link_file "$HOME/.codex/logs_2.sqlite" "$external/caches/codex/logs_2.sqlite"

# The Cellar stays on the internal disk: a symlinked keg makes brew report "not
# inside a keg", which fails brew bundle on every apply.
{{ end -}}
