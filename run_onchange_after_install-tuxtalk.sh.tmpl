{{- if ne (env "SKIP_DNF_INSTALL") "1" -}}
#!/bin/bash
set -euo pipefail

# TuxTalk has no dnf repository; after the first install its own updater installs new release RPMs
if rpm -q tuxtalk >/dev/null 2>&1; then
    exit 0
fi
arch=$(uname -m)
if [[ ${arch} != x86_64 ]]; then
    echo 'TuxTalk RPM is x86_64 only'
    exit 0
fi
release=$(curl -fsSL https://api.github.com/repos/ronb1964/TuxTalk/releases/latest)
version=$(jq -er '.tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))' <<<"${release}")
asset=$(jq -er --arg prefix "tuxtalk-${version#v}-" \
    '.assets[] | select(.name | startswith($prefix) and endswith(".x86_64.rpm")) | .name' <<<"${release}")
digest=$(jq -er --arg name "${asset}" \
    '.assets[] | select(.name == $name) | .digest | select(startswith("sha256:")) | ltrimstr("sha256:")' <<<"${release}")
url=$(jq -er --arg name "${asset}" '.assets[] | select(.name == $name) | .browser_download_url' <<<"${release}")
download=$(mktemp --suffix=.rpm)
trap 'rm -f "$download"' EXIT
curl -fsSL -o "${download}" "${url}"
printf '%s  %s\n' "${digest}" "${download}" | sha256sum -c -
sudo dnf install -y "${download}"
printf 'Installed TuxTalk %s\n' "${version}"
{{ end -}}
