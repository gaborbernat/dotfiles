#!/bin/bash
set -euo pipefail

if [[ "${SKIP_FEDORA_PANEL:-}" == "1" ]]; then
    exit 0
fi
if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]] || ! command -v gsettings >/dev/null 2>&1; then
    echo "GNOME session not available; panel setup will retry on the next chezmoi apply"
    exit 0
fi
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && ! -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
    echo "GNOME session bus not available; panel setup will retry on the next chezmoi apply"
    exit 0
fi
if ! gsettings list-schemas | grep -qx 'org.gnome.shell.extensions.dash-to-panel'; then
    echo "Dash to Panel RPM not installed yet; panel setup will retry on the next chezmoi apply"
    exit 0
fi
if ! command -v gnome-extensions >/dev/null 2>&1; then
    echo "gnome-extensions unavailable; panel setup will retry on the next chezmoi apply"
    exit 0
fi

gsettings set org.gnome.shell.extensions.dash-to-panel multi-monitors true
gsettings set org.gnome.shell.extensions.dash-to-panel panel-position 'TOP'
gsettings set org.gnome.shell.extensions.dash-to-panel show-favorites-all-monitors true
uuid=dash-to-panel@jderose9.github.com
schema=org.gnome.shell.extensions.dash-to-panel
positions=$(gsettings get "$schema" panel-positions)
if [[ "$positions" =~ :\"(BOTTOM|LEFT|RIGHT)\" ]]; then
    gsettings set "$schema" panel-positions '{}'
fi
system_schema=/usr/share/glib-2.0/schemas/$schema.gschema.xml
override=$HOME/.local/share/gnome-shell/extensions/$uuid
if [[ -f "$system_schema" ]] && grep -q 'name="clone-main-panel"' "$system_schema"; then
    if [[ -f "$override/metadata.json" ]] && jq -e '.version == 9999' "$override/metadata.json" >/dev/null; then
        gnome-extensions uninstall "$uuid"
    fi
    gsettings set "$schema" clone-main-panel true
else
    if [[ ! -f "$override/panel.js" || ! -f "$override/appIcons.js" ]] || \
        [[ $(sha256sum "$override/panel.js" | cut -d' ' -f1) != e6668dd6bef3ea7ab669d51400d75e1e48684b803850e515aeb3f2d997cf8703 ]] || \
        [[ $(sha256sum "$override/appIcons.js" | cut -d' ' -f1) != 050741a10e5755dd51322e10d70b43e27ed4584092e1707203e8083bb41d95c2 ]]; then
        archive=$(mktemp --suffix=.tar.gz)
        source=$(mktemp -d)
        trap 'rm -f "$archive"; rm -rf "$source"' EXIT
        curl -fsSL --retry 3 -o "$archive" \
            https://codeload.github.com/Laertes87/dash-to-panel/tar.gz/e3ef7d2a9e528d24a8e72fd1652aba722f2bd8aa
        echo "943de3a6483714f0d22edbf626810c6b6d5dee8066696b940f3cc5d2accd1c0c  $archive" | sha256sum -c -
        tar -xzf "$archive" -C "$source" --strip-components=1
        git -C "$source" apply --unidiff-zero {{ joinPath .chezmoi.sourceDir "scripts/fedora/dash-to-panel-compat.diff" | quote }}
        make -s -C "$source" zip-file VERSION=9999
        gnome-extensions install --force "$source/$uuid"_v9999.zip
    fi
    GSETTINGS_SCHEMA_DIR="$override/schemas" gsettings set "$schema" clone-main-panel true
fi
current=$(gsettings get org.gnome.shell enabled-extensions)
extensions=(dash-to-panel@jderose9.github.com focused-switcher@bernat.tech magnet-tiling@bernat.tech)
if [[ -d /usr/share/gnome-shell/extensions/appindicatorsupport@rgcjonas.gmail.com ]]; then
    extensions+=(appindicatorsupport@rgcjonas.gmail.com)
fi
if [[ -d "$HOME/.local/share/gnome-shell/extensions/monitor@astraext.github.io" ]]; then
    extensions+=(monitor@astraext.github.io)
fi
updated=$(python3 -c '
import ast
import sys

options = ast.literal_eval(sys.argv[1].removeprefix("@as "))
options = [name for name in options if name not in {
    "multi-monitors-bar@frederykabryan",
    "window-list@gnome-shell-extensions.gcampax.github.com",
    "dictation-indicator@bernat.tech",
}]
for name in sys.argv[2:]:
    if name not in options:
        options.append(name)
print(repr(options))
' "$current" "${extensions[@]}")
if [[ "$updated" != "$current" ]]; then
    gsettings set org.gnome.shell enabled-extensions "$updated"
    echo "Enabled Fedora GNOME extensions (log out and back in if they are not visible yet)"
fi
