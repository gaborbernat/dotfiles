[Unit]
Description=Antec Flux Pro CPU/GPU temperature display
After=systemd-udevd.service

[Service]
Type=simple
User=antec-flux
Group=antec-flux
ExecStart=/usr/local/bin/antec-flux-pro-display
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
