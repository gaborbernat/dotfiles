file usr/share/gamescope-session-plus/device-quirks
file usr/share/gamescope-session-plus/gamescope-session-plus
file usr/share/gamescope/scripts/50-custom/50-disable-explicit-sync.lua
file usr/bin/steamos-session-select
file usr/bin/steamos-update
file usr/bin/steamos-select-branch
file usr/bin/jupiter-biosupdate
file usr/share/gamescope-session-plus/sessions.d/steam
file usr/share/wayland-sessions/gamescope-session-steam.desktop
helper steamos-update
helper jupiter-biosupdate
helper steamos-select-branch
