#!/usr/bin/bash
# Opens Big Picture in the desktop session, starting Steam if needed.
set -euo pipefail

# GNOME ignores gamepad input as activity, so blanked screens stay dark when the controller connects
/usr/bin/gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver \
    --method org.gnome.ScreenSaver.SetActive false >/dev/null
# GNOME also blanks them mid-menu, so hold an idle inhibitor while any Xbox controller stays connected.
if ! /usr/bin/systemctl --user is-active --quiet steam-tv-awake.service; then
    /usr/bin/systemd-run --user --collect --quiet --unit=steam-tv-awake \
        /usr/bin/gnome-session-inhibit --inhibit=idle --app-id=steam --reason='Xbox controller connected' \
        /usr/bin/bash -c 'while grep -sqx @XBOX_VENDOR@ /sys/class/input/js*/device/id/vendor; do sleep 10; done'
fi

# A controller waking up mid-game must not yank the player out to Big Picture
if /usr/bin/pgrep --uid "${UID}" --full 'reaper SteamLaunch' >/dev/null; then
    exit 0
fi
if /usr/bin/pgrep --uid "${UID}" --exact steam >/dev/null; then
    /usr/bin/steam steam://open/bigpicture
else
    /usr/bin/systemd-run --user --collect --unit=steam-big-picture /usr/bin/steam steam://open/bigpicture
fi

# Steam opens Big Picture on the primary display, the desk BenQ while it is on, and GNOME leaves windows from
# background units unfocused, so the focused-switcher extension moves it to the TV and focuses it.
for _ in {1..60}; do
    shown=$(/usr/bin/gdbus call --session --dest org.gnome.Shell \
        --object-path /org/gnome/Shell/Extensions/FocusedSwitcher \
        --method org.bernat.FocusedSwitcher.ShowOnTv 'Steam Big Picture Mode' 2>/dev/null) || true
    [[ "${shown}" == '(true,)' ]] && exit 0
    sleep 1
done
echo 'Big Picture window did not appear; left it where Steam placed it.' >&2
