[Unit]
Description=Exit Steam and turn the TV off after the last controller disconnects

[Service]
Type=oneshot
StateDirectory=steam-tv
StateDirectoryMode=0700
ExecStart=/usr/local/bin/steam-tv-off
TimeoutStartSec=180
# Runs as root and talks to the TV over the LAN, so drop what the triggers never need
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
