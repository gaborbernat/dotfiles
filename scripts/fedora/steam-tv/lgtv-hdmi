#!/usr/bin/python3
"""Wake the LG TV and switch it to the PC's HDMI input, or turn it off, over webOS's SSAP websocket API.

Usage: lgtv-hdmi KEY_FILE [on|off]
"""

import hashlib
import json
import logging
import socket
import ssl
import sys
import time
from pathlib import Path
from typing import TYPE_CHECKING, Final, TypedDict, TypeIs

from websockets.exceptions import WebSocketException
from websockets.sync.client import ClientConnection, connect

if TYPE_CHECKING:
    from websockets.sync.connection import Connection

_BOOT_SECONDS: Final[int] = 30
_HDMI_INPUT: Final[str] = "HDMI_1"
_HDMI_APP: Final[str] = "com.webos.app.hdmi1"
_LOG: Final[logging.Logger] = logging.getLogger("lgtv-hdmi")


def main() -> None:
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    key_file = Path(sys.argv[1])
    if sys.argv[2:] == ["off"]:
        turn_off(key_file)
        return
    wake()
    deadline = time.monotonic() + _BOOT_SECONDS
    while True:
        try:
            with open_tv() as tv:
                register(tv, key_file)
                ensure_screen_on(tv)
                request(tv, "ssap://tv/switchInput", {"inputId": _HDMI_INPUT})
            break
        # A booting TV refuses connections, or accepts one and closes it with 1008 Try Again Later
        except (OSError, WebSocketException) as error:
            if time.monotonic() > deadline:
                sys.exit(f"lgtv-hdmi: {error}")
            time.sleep(1)
        except RuntimeError as error:
            sys.exit(f"lgtv-hdmi: {error}")
    _LOG.info("TV on, input %s", _HDMI_INPUT)


def turn_off(key_file: Path) -> None:
    try:
        with open_tv() as tv:
            register(tv, key_file)
            app = request(tv, "ssap://com.webos.applicationManager/getForegroundAppInfo").get("appId")
            # Someone switched to another input or app after playing; the TV is theirs now
            if app == _HDMI_APP:
                request(tv, "ssap://system/turnOff")
    # A TV that refuses the connection is already off
    except OSError, WebSocketException:
        _LOG.info("TV already off")
    except RuntimeError as error:
        sys.exit(f"lgtv-hdmi: {error}")
    else:
        _LOG.info("TV off" if app == _HDMI_APP else f"TV left on, showing {app}")


def wake() -> None:
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.sendto(b"\xff" * 6 + bytes.fromhex("60756c9ff496") * 16, ("255.255.255.255", 9))


def open_tv() -> ClientConnection:
    # webOS serves a self-signed certificate, so there is no chain to verify; register pins it on first use instead
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    return connect("wss://LGwebOSTV.local:3001", ssl=context, open_timeout=3)


def register(tv: Connection, key_file: Path) -> None:
    pin_check(tv, key_file.with_name("lgtv-cert-sha256"))
    payload = {
        "forcePairing": False,
        "pairingType": "PROMPT",
        "manifest": {
            "manifestVersion": 1,
            "appVersion": "1.1",
            # webOS grants switchInput only to clients asking for the full set the LG remote apps request
            "permissions": [
                "APP_TO_APP",
                "CLOSE",
                "CONTROL_AUDIO",
                "CONTROL_DISPLAY",
                "CONTROL_INPUT_JOYSTICK",
                "CONTROL_INPUT_MEDIA_PLAYBACK",
                "CONTROL_INPUT_MEDIA_RECORDING",
                "CONTROL_INPUT_TEXT",
                "CONTROL_INPUT_TV",
                "CONTROL_MOUSE_AND_KEYBOARD",
                "CONTROL_POWER",
                "CONTROL_TV_SCREEN",
                "LAUNCH",
                "LAUNCH_WEBAPP",
                "READ_APP_STATUS",
                "READ_COUNTRY_INFO",
                "READ_CURRENT_CHANNEL",
                "READ_INPUT_DEVICE_LIST",
                "READ_INSTALLED_APPS",
                "READ_LGE_SDX",
                "READ_LGE_TV_INPUT_EVENTS",
                "READ_NETWORK_STATE",
                "READ_NOTIFICATIONS",
                "READ_POWER_STATE",
                "READ_RUNNING_APPS",
                "READ_SETTINGS",
                "READ_TV_CHANNEL_LIST",
                "READ_TV_CURRENT_TIME",
                "READ_UPDATE_INFO",
                "SEARCH",
                "TEST_OPEN",
                "TEST_PROTECTED",
                "TEST_SECURE",
                "UPDATE_FROM_REMOTE_APP",
                "WRITE_NOTIFICATION_ALERT",
                "WRITE_NOTIFICATION_TOAST",
                "WRITE_SETTINGS",
            ],
        },
    }
    if key_file.exists():
        payload["client-key"] = key_file.read_text(encoding="utf-8").strip()
    tv.send(json.dumps({"type": "register", "id": "register", "payload": payload}))
    while True:
        message = receive(tv, 60)
        if message.get("type") == "registered":
            key_file.write_text(message["payload"]["client-key"], encoding="utf-8")
            return
        if message.get("type") == "error":
            msg = f"pairing refused: {message.get('error')}"
            raise RuntimeError(msg)
        if message.get("payload", {}).get("pairingType") == "PROMPT":
            _LOG.info("Accept the connection prompt on the TV with its remote")


def pin_check(tv: Connection, pin_file: Path) -> None:
    # Any LAN host can answer for LGwebOSTV.local, and the pairing key grants full control of the TV, so it goes only to
    # the certificate seen on the first connection
    if not isinstance(sock := tv.socket, ssl.SSLSocket) or (der := sock.getpeercert(binary_form=True)) is None:
        msg = "TV presented no certificate"
        raise RuntimeError(msg)
    seen = hashlib.sha256(der).hexdigest()
    if not pin_file.exists():
        pin_file.write_text(seen, encoding="utf-8")
    elif (pinned := pin_file.read_text(encoding="utf-8").strip()) != seen:
        msg = f"TV certificate {seen} differs from pinned {pinned}; after a TV reset or update, delete {pin_file}"
        raise RuntimeError(msg)


def receive(tv: Connection, timeout: float) -> _Message:
    if is_message(message := json.loads(tv.recv(timeout=timeout))):
        return message
    msg = f"unexpected TV message {message!r}"
    raise RuntimeError(msg)


def is_message(value: object) -> TypeIs[_Message]:
    return isinstance(value, dict)


class _Message(TypedDict, total=False):
    type: str
    id: str
    error: str
    payload: _Payload


_Payload = TypedDict(
    "_Payload", {"appId": str, "client-key": str, "pairingType": str, "returnValue": bool, "state": str}, total=False
)


def ensure_screen_on(tv: Connection) -> None:
    deadline = time.monotonic() + _BOOT_SECONDS
    # The screensaver means the current input has no signal; switching to the PC's input dismisses it
    while (state := request(tv, "ssap://com.webos.service.tvpower/power/getPowerState").get("state")) not in {
        "Active",
        "Screen Saver",
    }:
        if time.monotonic() > deadline:
            msg = f"TV stayed in power state {state!r}"
            raise RuntimeError(msg)
        if state == "Screen Off":
            request(tv, "ssap://com.webos.service.tvpower/power/turnOnScreen")
        time.sleep(1)


def request(tv: Connection, uri: str, payload: dict[str, str] | None = None) -> _Payload:
    tv.send(json.dumps({"type": "request", "id": uri, "uri": uri, "payload": payload or {}}))
    while (message := receive(tv, 10)).get("id") != uri:
        pass
    if message.get("type") == "error" or not message["payload"].get("returnValue", True):
        msg = f"{uri} failed: {message.get('error') or message['payload']}"
        raise RuntimeError(msg)
    return message["payload"]


if __name__ == "__main__":
    main()
