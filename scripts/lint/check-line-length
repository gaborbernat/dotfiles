#!/usr/bin/env python3
"""Fail on lines wider than 120 columns in files no formatter wraps."""

import sys
from pathlib import Path


def main() -> None:
    too_long = [
        f"{path}:{number}: {len(line)} > 120 columns"
        for path in sys.argv[1:]
        for number, line in enumerate(Path(path).read_text(encoding="utf-8").splitlines(), start=1)
        if len(line) > 120
    ]
    sys.stdout.writelines(f"{entry}\n" for entry in too_long)
    sys.exit(bool(too_long))


if __name__ == "__main__":
    main()
