#!/usr/bin/env python3
"""Lint chezmoi templates by rendering them and checking the output as the file type they become."""

import json
import subprocess
import sys
import tomllib
from pathlib import Path
from tempfile import TemporaryDirectory
from typing import Final

_SHELL_SHEBANGS: Final = ("#!/bin/bash", "#!/usr/bin/bash", "#!/usr/bin/env bash", "#!/bin/sh", "#!/usr/bin/env sh")
_PYTHON_SHEBANGS: Final = ("#!/usr/bin/python3", "#!/usr/bin/env python3")


def main() -> None:
    failed = False
    for template in map(Path, sys.argv[1:]):
        render = subprocess.run(
            ["chezmoi", "execute-template", "--source", str(Path.cwd())],
            input=template.read_text(encoding="utf-8"),
            capture_output=True,
            text=True,
            check=False,
        )
        if render.returncode:
            sys.stdout.write(f"{template}: does not render\n{render.stderr}")
            failed = True
        elif render.stdout.strip() and (problems := lint(template, render.stdout)):
            sys.stdout.write(f"{template}: rendered output fails\n{problems}")
            failed = True
    sys.exit(failed)


def lint(template: Path, rendered: str) -> str:
    target = template.name.removesuffix(".tmpl")
    if target.endswith(".sh") or rendered.startswith(_SHELL_SHEBANGS):
        return run(["shellcheck", "--enable=all", "-"], rendered) + run(
            ["shfmt", "-i", "4", "-ci", "-d", "--filename", target], rendered
        )
    if target.endswith(".py") or rendered.startswith(_PYTHON_SHEBANGS):
        return lint_python(template, rendered)
    if target.endswith(".js"):
        biome: Final = ["biome", "check", "--indent-style=space", "--indent-width=4", "--line-width=120"]
        return run_on_file([*biome, "--javascript-formatter-quote-style=single"], target, rendered)
    if target.endswith(".fish"):
        return run(["fish", "--no-execute"], rendered) + run(["fish_indent", "--check"], rendered)
    if target.endswith((".yaml", ".yml")):
        yamllint_config = "{extends: default, rules: {line-length: {max: 120}}}"
        return run(["yamllint", "--strict", "-d", yamllint_config, "-"], rendered)
    return parse_error(target, rendered)


def lint_python(template: Path, rendered: str) -> str:
    # The target path lets ruff find the same configuration it would use for the rendered file
    stdin_filename: Final = f"--stdin-filename={template.with_suffix('')}"
    ty: Final = ["uv", "run", "--quiet", "--project", "dot_local/scripts", "--all-groups", "ty", "check"]
    # Scripts import modules installed beside them, so resolve imports from the template's directory too
    ty_options: Final = ["--python", "dot_local/scripts/.venv", "--extra-search-path", str(template.parent)]
    return (
        run(["ruff", "format", "--diff", stdin_filename, "-"], rendered)
        + run(["ruff", "check", "--no-fix", stdin_filename, "-"], rendered)
        + run_on_file([*ty, *ty_options], template.with_suffix("").name, rendered)
    )


def run_on_file(command: list[str], target: str, rendered: str) -> str:
    with TemporaryDirectory() as directory:
        (rendered_file := Path(directory) / target).write_text(rendered, encoding="utf-8")
        return run([*command, str(rendered_file)], "")


def parse_error(target: str, rendered: str) -> str:
    try:
        if target.endswith(".toml"):
            tomllib.loads(rendered)
        elif target.endswith(".json"):
            json.loads(rendered)
    except (tomllib.TOMLDecodeError, json.JSONDecodeError) as error:
        return f"{error}\n"
    return ""


def run(command: list[str], rendered: str) -> str:
    result = subprocess.run(command, input=rendered, capture_output=True, text=True, check=False)
    return result.stdout + result.stderr if result.returncode else ""


if __name__ == "__main__":
    main()
