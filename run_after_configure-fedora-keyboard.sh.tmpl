#!/bin/bash
set -euo pipefail

if [[ "${SKIP_FEDORA_KEYBOARD:-}" == 1 ]]; then
    exit 0
fi
if ! command -v xremap >/dev/null 2>&1; then
    echo "xremap unavailable; keyboard setup will retry after DNF setup"
    exit 0
fi

sudo bash '{{ .chezmoi.sourceDir }}/scripts/fedora/keyboard/install-system.sh' \
    '{{ .chezmoi.sourceDir }}/scripts/fedora/keyboard/config.yml' "$(id -un)"

if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]] ||
    [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && ! -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
    echo "GNOME session unavailable; xremap extension will install on the next chezmoi apply"
    exit 0
fi

uuid=xremap@k0kubun.com
installed_version=$(python3 -c '
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
print(json.loads(path.read_text())["version"] if path.is_file() else "")
' "$HOME/.local/share/gnome-shell/extensions/$uuid/metadata.json")
if [[ "$installed_version" != 16 ]]; then
    zip=$(mktemp --suffix=.zip)
    trap 'rm -f "$zip"' EXIT
    curl -fL -sS -o "$zip" \
        "https://extensions.gnome.org/download-extension/$uuid.shell-extension.zip?version_tag=76494"
    printf '%s  %s\n' \
        'ec9544258550a4e84b1fb0e86eb6eea9174ba15f3c0b2acb41576eca6ebb620f' \
        "$zip" | sha256sum -c -
    gnome-extensions install --force "$zip"
fi

current=$(gsettings get org.gnome.shell enabled-extensions)
updated=$(python3 -c '
import ast
import sys

extensions = ast.literal_eval(sys.argv[1].removeprefix("@as "))
if sys.argv[2] not in extensions:
    extensions.append(sys.argv[2])
print(repr(extensions))
' "$current" "$uuid")
if [[ "$updated" != "$current" ]]; then
    gsettings set org.gnome.shell enabled-extensions "$updated"
fi
current=$(gsettings get org.gnome.shell disabled-extensions)
updated=$(python3 -c '
import ast
import sys

extensions = ast.literal_eval(sys.argv[1].removeprefix("@as "))
extensions = [extension for extension in extensions if extension != sys.argv[2]]
print(repr(extensions) if extensions else "@as []")
' "$current" "$uuid")
if [[ "$updated" != "$current" ]]; then
    gsettings set org.gnome.shell disabled-extensions "$updated"
fi
for digit in {1..9}; do
    gsettings set org.gnome.shell.keybindings "switch-to-application-$digit" '@as []'
done
gsettings set org.gnome.shell.keybindings toggle-message-tray "['<Super>m']"
gsettings set org.gnome.mutter.keybindings switch-monitor "['XF86Display']"
gsettings set org.gnome.shell.keybindings show-screenshot-ui "['Print', '<Super>p']"
# Super+arrows go to Ghostty split navigation; Shift+Super+arrows drive magnet-tiling@bernat.tech.
gsettings set org.gnome.mutter.keybindings toggle-tiled-left "['<Shift><Super>Left']"
gsettings set org.gnome.mutter.keybindings toggle-tiled-right "['<Shift><Super>Right']"
gsettings set org.gnome.desktop.wm.keybindings maximize "['<Shift><Super>Up']"
gsettings set org.gnome.desktop.wm.keybindings unmaximize "['<Shift><Super>Down', '<Alt>F5']"
for direction in left right up down; do
    gsettings set org.gnome.desktop.wm.keybindings "move-to-monitor-$direction" '@as []'
done
echo "xremap extension enabled"
