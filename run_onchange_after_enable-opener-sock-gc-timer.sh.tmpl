#!/bin/bash
# Service hash: {{ include "dot_config/systemd/private_user/opener-sock-gc.service" | sha256sum }}
# Timer hash: {{ include "dot_config/systemd/private_user/opener-sock-gc.timer" | sha256sum }}
set -euo pipefail

# Without linger the user manager, and with it the timer, stops once the last session ends,
# which is exactly when a dropped tunnel leaves the socket behind.
loginctl enable-linger "$USER"
systemctl --user daemon-reload
systemctl --user enable --now opener-sock-gc.timer
echo "✅ opener socket cleaner timer enabled"
