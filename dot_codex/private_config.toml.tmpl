{{- $work := joinPath .chezmoi.homeDir ".local/share/chezmoi-private/codex_work.toml" -}}
suppress_unstable_features_warning = true
developer_instructions = "Do not add AI co-author trailers or generated-by attribution to commits or pull requests."

# Prompt when escalating out of the sandbox, matching Claude Code, which auto-runs in-scope actions and asks for the
# rest. sandbox_mode stays unset because default_permissions below overrides it.
approval_policy = "on-request"
approvals_reviewer = "auto_review"

# Matches Claude Code: read everything, write the workspace, network on.
default_permissions = "dev"
{{ output "sh" "-c" `awk '/^\[/{exit} /^(model|model_reasoning_effort|notify|service_tier|daybreak) = /' "$HOME/.codex/config.toml" 2>/dev/null || true` }}
[permissions.dev.filesystem]
":root" = "read"
":workspace_roots" = "write"
{{ if eq .chezmoi.os "linux" }}
"~/.local/libexec" = "write"
"~/.local/share/dbus-1/services" = "write"
"~/.local/share/gnome-shell/extensions" = "write"
"~/.config/systemd/user" = "write"
{{ end }}

[permissions.dev.network]
enabled = true

# One workspace-mcp per Google account: a separate credentials dir pins each to its own login.
# Client ID/secret come from ~/.secrets.
[mcp_servers.gmail]
command = "uvx"
args = [
  "workspace-mcp@latest",
  "--single-user",
  "--permissions",
  "gmail:full",
  "--disabled-tools",
  "send_gmail_message",
]
env_vars = ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET"]
startup_timeout_sec = 60

[mcp_servers.gmail.env]
WORKSPACE_MCP_CREDENTIALS_DIR = "{{ .chezmoi.homeDir }}/.local/share/workspace-mcp/gaborjbernat"
USER_GOOGLE_EMAIL = "gaborjbernat@gmail.com"

# A filter can silently trash mail (e.g. security alerts), so an injected email must not be able to create one unseen.
[mcp_servers.gmail.tools.manage_gmail_filter]
approval_mode = "prompt"

# Sharing changes stay off so an injected prompt can't publish files.
[mcp_servers.gdrive]
command = "uvx"
args = [
  "workspace-mcp@latest",
  "--single-user",
  "--permissions",
  "drive:full",
  "--disabled-tools",
  "manage_drive_access",
  "set_drive_file_permissions",
]
env_vars = ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET"]
startup_timeout_sec = 60

[mcp_servers.gdrive.env]
WORKSPACE_MCP_CREDENTIALS_DIR = "{{ .chezmoi.homeDir }}/.local/share/workspace-mcp/jokerjokerer"
USER_GOOGLE_EMAIL = "jokerjokerer@gmail.com"
{{ if stat $work }}{{ output "cat" $work }}{{ end -}}
{{ output "sh" "-c" `kept=$(awk '/^\[/{f=($0 ~ /^\[(tui(\]|\.model_availability_nux\])|projects\.|notice\]|desktop\]|marketplaces\.|plugins\.|mcp_servers\.node_repl)/)} f' "$HOME/.codex/config.toml" 2>/dev/null); test -n "$kept" && printf '\n%s\n\n' "$kept" || true` -}}
