# Mirrors Claude Code's permissions.allow Bash(...) rules. Listed commands auto-run under
# approval_policy = "on-request"; everything else prompts. prefix_rule matches an ordered argv prefix, not a glob, so
# pattern=["git"] is Bash(git *). execpolicy is a Codex preview feature, and an "allow" decision also bypasses the
# sandbox.

{{ range $command := concat .agent_commands.shared (list "codex" "npm") | sortAlpha -}}
prefix_rule(pattern = [{{ $command | quote }}], decision = "allow")
{{ end -}}
prefix_rule(pattern = ["python", "-m", "pytest"], decision = "allow")
prefix_rule(pattern = ["uv", "pip", "install"], decision = "allow")
{{ output "sh" "-c" `kept=$(grep '^prefix_rule(pattern=\[' "$HOME/.codex/rules/default.rules" 2>/dev/null); test -n "$kept" && printf '%s\n' "$kept" || true` -}}
