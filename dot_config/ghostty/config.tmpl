{{- if eq .chezmoi.os "darwin" }}
command = /opt/homebrew/bin/fish
{{- else }}
command = /usr/bin/fish
{{- end }}

theme = Monokai Remastered
minimum-contrast = 3
{{- if eq .chezmoi.os "darwin" }}
font-family = JetBrainsMono Nerd Font
font-family = Symbols Nerd Font Mono
{{- else }}
font-family = JetBrains Mono
{{- end }}
font-size = 12
font-feature = calt
font-feature = clig
font-feature = liga
adjust-cell-height = -5%
adjust-cursor-height = 100%
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend
{{- if eq .chezmoi.os "darwin" }}
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
{{- else }}
gtk-titlebar-style = tabs
{{- end }}

cursor-style = bar
cursor-style-blink = true

scrollback-limit = 100000000
mouse-hide-while-typing = true
focus-follows-mouse = true
copy-on-select = clipboard
selection-clear-on-copy = true
clipboard-paste-protection = false
split-divider-color = #998A00
split-preserve-zoom = navigation

window-inherit-font-size = false
window-save-state = always
{{- if eq .chezmoi.os "darwin" }}
window-colorspace = display-p3
{{- end }}

notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
scroll-to-bottom = keystroke,output
selection-word-chars = \t\n{}[]()\"'`,;:@
{{- if eq .chezmoi.os "darwin" }}
macos-applescript = false
{{- end }}

# near-opaque: dark background barely see-through; also powers the super+shift+o toggle
background-opacity = 0.98
{{- if eq .chezmoi.os "darwin" }}
macos-window-shadow = false
font-thicken = true
{{- end }}
mouse-scroll-multiplier = 2
resize-overlay = never
{{- if eq .chezmoi.os "darwin" }}
macos-option-as-alt = true
{{- end }}
quit-after-last-window-closed = true
confirm-close-surface = false
undo-timeout = 1m

{{- if eq .chezmoi.os "darwin" }}
keybind = global:super+grave_accent=toggle_quick_terminal
{{- end }}
keybind = shift+enter=text:\x1b\r
keybind = super+a=text:\x1b[97;9u
keybind = super+q=quit
keybind = super+h=new_split:right
keybind = super+j=new_split:down
keybind = super+d=close_surface
keybind = super+w=close_surface
{{- if eq .chezmoi.os "darwin" }}
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:up
keybind = super+down=goto_split:down
{{- else }}
keybind = ctrl+shift+alt+left=goto_split:left
keybind = ctrl+shift+alt+right=goto_split:right
keybind = ctrl+shift+alt+up=goto_split:up
keybind = ctrl+shift+alt+down=goto_split:down
{{- end }}
keybind = super+shift+f=toggle_split_zoom
keybind = super+page_up=previous_tab
keybind = super+page_down=next_tab
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+up=scroll_page_lines:-1
keybind = shift+down=scroll_page_lines:1
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
keybind = super+shift+o=toggle_background_opacity
{{- if ne .chezmoi.os "darwin" }}
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+t=new_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9
{{- end }}
