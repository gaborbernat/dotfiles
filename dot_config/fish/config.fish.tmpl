# Core
{{- if eq .chezmoi.os "darwin" }}
set -gx EDITOR 'code --wait'
set -gx VISUAL 'code --wait'
set -gx SHELL /opt/homebrew/bin/fish
{{- else }}
if command -q code
    set -gx EDITOR 'code --wait'
    set -gx VISUAL 'code --wait'
else
    set -gx EDITOR vi
    set -gx VISUAL vi
end
set -gx SHELL (command -v fish)
{{- if eq .chezmoi.osRelease.id "fedora" }}
set -gx NPM_CONFIG_PREFIX $HOME/.local
{{- end }}
{{- end }}
# Tools that honor BROWSER skip `open`; route them through the et-aware wrapper too.
set -q ET_VERSION; and set -gx BROWSER $HOME/.local/libexec/et-open/open
set -gx DEBUG_PRINT_LIMIT 1000000
set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"

# Path
{{- if eq .chezmoi.os "darwin" }}
set -gx PATH \
    $HOME/.local/sbin \
    $HOME/.local/bin \
    $HOME/.cargo/bin \
    /opt/homebrew/sbin \
    /opt/homebrew/bin/ \
    /usr/local/bin \
    /opt/homebrew/opt/ed/bin \
    /opt/homebrew/opt/flex/bin \
    /opt/homebrew/opt/zip/bin \
    /Applications/Docker.app/Contents/Resources/bin \
    $HOME/go/bin \
    $PATH

# The GNU tool dirs go through fish_user_paths, not the plain PATH above: `mise activate` (below)
# rebuilds $PATH system-first on every cd, burying them behind the macOS BSD equivalents, but fish
# re-applies fish_user_paths on top of whatever mise produces. Keeps rm/sed/awk resolving to GNU.
fish_add_path --prepend --move \
    /opt/homebrew/opt/coreutils/libexec/gnubin \
    /opt/homebrew/opt/gnu-sed/libexec/gnubin \
    /opt/homebrew/opt/gawk/libexec/gnubin \
    /opt/homebrew/opt/gnu-indent/libexec/gnubin \
    /opt/homebrew/opt/findutils/libexec/gnubin \
    /opt/homebrew/opt/make/libexec/gnubin

# bb-homebrew
set -gx PKG_CONFIG_PATH \
    /opt/homebrew/opt/openssl@1.1/lib/pkgconfig \
    /opt/homebrew/opt/python@3.14/lib/pkgconfig

set -gx MACOSX_DEPLOYMENT_TARGET (sw_vers -productVersion)
set -gx LDFLAGS "-L/opt/homebrew/opt/ncurses/lib -L/opt/homebrew/opt/sqlite/lib -L/opt/homebrew/opt/librdkafka/lib/"
set -e CFLAGS
set -gx CPPFLAGS "-I/opt/homebrew/opt/ncurses/include -I/opt/homebrew/opt/sqlite/include -I/opt/homebrew/opt/librdkafka/include"

set -gx PY_PYTHON 3.14
set -gx HOMEBREW_NO_ANALYTICS 1
{{- else }}
set -gx PATH \
    $HOME/.local/sbin \
    $HOME/.local/bin \
    $HOME/.cargo/bin \
    $HOME/go/bin \
    /opt/bb/bin \
    /usr/share/vscode-server-linux-x64-web/bin/remote-cli \
    $PATH
{{- end }}
# The et-aware `open` wrapper goes through fish_user_paths so `mise activate` can't bury it, kept in its
# own dir so the rest of ~/.local/bin keeps its place. Outside et sessions it hands straight to the
# platform opener.
fish_add_path --prepend --move $HOME/.local/libexec/et-open

# GO
set -gx GOPATH $HOME/go

set -gx DIFF_AGAINST upstream/main

if status --is-interactive
    # Add local functions directory
    set --global fish_function_path $__fish_config_dir/local_functions $fish_function_path

    # abbreviations
    abbr --add g git
    abbr --add grv "gh repo view -w"
    abbr --add gpv "gh pr view -w"
    abbr --add prs "gh pr create -f; gh pr view -w"
    abbr --add prsd "gh pr create -f -d; gh pr view -w"
    abbr --add gca "git aa; git can; git pu -f"
    abbr --add l lsd
    abbr --add v nvim
    abbr --add t tig
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") }}
    abbr --add gdu gdu
{{- else }}
    abbr --add gdu gdu-go
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
    abbr --add b bat
{{- else }}
    abbr --add b "env TERM=xterm-256color bat"
{{- end }}
    abbr --add d docker compose
    abbr --add du 'docker compose up -d --wait'
    abbr --add do 'docker compose down'
    abbr --add de 'docker compose exec app'

    abbr --add c claude
    abbr --add cl 'claude --continue'
    abbr --add pcu 'prek autoupdate -j 12'
    abbr --add pcr 'prek run --all-files'

    # load tools
    command -q zoxide && zoxide init fish | source
    command -q atuin && atuin init fish | source
    command -q mise && mise activate fish | source
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") }}
    fish_add_path --path --prepend --move $HOME/.local/bin
{{- end }}

    # fish interactive changes
    set fish_greeting
    function fish_title
        set -l cmd $argv[1]
        set -l cwd (basename $PWD)
        if set -l git_root (git rev-parse --show-toplevel 2>/dev/null)
            set -l project (basename $git_root)
            test "$project" != "$cwd" && set cwd "$project/$cwd"
        end
        set -l title $cwd
        if test "$cmd" = ssh -o "$cmd" = tsh
            set title "$cmd: $cwd"
        else if test -n "$cmd" -a "$cmd" != fish
            set title "$cwd: $cmd"
        end
        # ssh, tsh, and mosh shells inherit SSH_CONNECTION; et sets ET_VERSION.
        if set -q SSH_CONNECTION; or set -q ET_VERSION
{{- if eq .chezmoi.hostname "Bernats-Mac-mini" }}
            set title "mini: $title"
{{- else }}
            set title (prompt_hostname)": $title"
{{- end }}
        end
        echo $title
    end

    function dbu -a val
        docker compose down $val
        docker compose --progress plain build $val && docker compose up $val --abort-on-container-exit --abort-on-container-failure
    end

    function dbud -a val
        docker compose down $val
        docker compose --progress plain build $val && docker compose up $val --detach --yes
    end

    function dbr -a val
        docker compose build $val && docker compose run --rm $val
    end
    command -q direnv && direnv hook fish | source

    # Source work-specific config if exists
    if test -f "$HOME/.local/share/chezmoi-private/fish_work.fish"
        source "$HOME/.local/share/chezmoi-private/fish_work.fish"
    end

    # Source secrets if exists
    if test -f "$HOME/.secrets"
        source "$HOME/.secrets"
    end

end

# bun
if test -d "$HOME/.bun"
    set --export BUN_INSTALL "$HOME/.bun"
    set --export PATH $BUN_INSTALL/bin $PATH
end

# Rust build speed: shrink dev target (DWARF debug info is the main size driver) while keeping
# incremental compilation and panic backtraces (file:line). Delete this line to restore full
# debug info for lldb variable inspection. Applies to every project/worktree.
set -gx CARGO_PROFILE_DEV_DEBUG line-tables-only
