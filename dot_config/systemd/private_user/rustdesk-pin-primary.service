[Unit]
Description=Pin RustDesk Wayland screen share to the HDMI dummy plug or primary monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/rustdesk-pin-primary
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
