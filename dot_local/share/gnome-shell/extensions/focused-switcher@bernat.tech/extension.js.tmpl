import Clutter from 'gi://Clutter';
import Gio from 'gi://Gio';
import GLib from 'gi://GLib';
import GObject from 'gi://GObject';
import Meta from 'gi://Meta';
import Shell from 'gi://Shell';
import St from 'gi://St';
import { Extension } from 'resource:///org/gnome/shell/extensions/extension.js';
import * as AltTab from 'resource:///org/gnome/shell/ui/altTab.js';
import * as Main from 'resource:///org/gnome/shell/ui/main.js';

const APP_BINDINGS = ['switch-applications', 'switch-applications-backward', 'switch-group', 'switch-group-backward'];
const TV_PRODUCT = '{{ .monitors.tv.product }}';
// order-monitors fixes the layout 500 ms after each change, so wait for both reconfigurations to land
const RELAYOUT_SETTLE_MS = 2000;
const BIG_PICTURE_TITLE = 'Steam Big Picture Mode';
// Big Picture grabs focus back right after a game's window appears; later switches to it are the player's own
const FOCUS_GRAB_WINDOW_MS = 3000;

// Steam, Big Picture and every game belong on the TV, whichever monitor launched them; Proton games run in gamescope
const isGameWindow = (window) => {
    const wmClass = window.get_wm_class() ?? '';
    return wmClass === 'gamescope' || wmClass.startsWith('steam_app_');
};
const isSteamWindow = (window) => window.get_wm_class() === 'steam' || isGameWindow(window);

export default class FocusedSwitcherExtension extends Extension {
    enable() {
        this._backend = global.get_backend();
        this._windowService = Gio.DBusExportedObject.wrapJSObject(
            `<node>
            <interface name="org.bernat.FocusedSwitcher">
                <method name="ListWindows">
                    <arg type="s" direction="out"/>
                </method>
                <method name="BringToCurrentMonitor">
                    <arg type="u" direction="in"/>
                </method>
                <method name="ShowOnTv">
                    <arg type="s" direction="in"/>
                    <arg type="b" direction="out"/>
                </method>
            </interface>
        </node>`,
            this,
        );
        this._windowService.export(Gio.DBus.session, '/org/gnome/Shell/Extensions/FocusedSwitcher');
        this._deviceName = null;
        this._mxMouseActive = false;
        this._focusMonitor = global.display.focus_window?.get_monitor() ?? global.display.get_current_monitor();
        this._previousFocusMonitor = this._focusMonitor;
        this._pendingWindows = new Map();
        this._tvWindows = new Map();
        this._relayoutTimeoutId = 0;
        const mxMaster = 'Logitech MX Master 3';

        this._deviceChangedId = this._backend.connect('last-device-changed', (_backend, device) => {
            this._deviceName = device?.get_device_name();
            if (device?.get_device_type() !== Clutter.InputDeviceType.POINTER_DEVICE) return;
            if (this._deviceName !== mxMaster) {
                this._mxMouseActive = false;
                return;
            }
            if (this._mxMouseActive) return;

            this._mxMouseActive = true;
            const monitorIndex = this._tvMonitor();
            if (monitorIndex < 0 || global.display.get_current_monitor() === monitorIndex) return;

            const monitor = Main.layoutManager.monitors[monitorIndex];
            if (monitor)
                Clutter.get_default_backend()
                    .get_default_seat()
                    .warp_pointer(
                        Math.floor(monitor.x + monitor.width / 2),
                        Math.floor(monitor.y + monitor.height / 2),
                    );
        });

        this._refocusGameId = 0;
        this._focusedGame = null;
        this._gameShownAt = new Map();
        this._focusChangedId = global.display.connect('notify::focus-window', () => {
            const window = global.display.focus_window;
            if (window?.get_window_type() !== Meta.WindowType.NORMAL) return;

            this._previousFocusMonitor = this._focusMonitor;
            this._focusMonitor = window.get_monitor();
            const previousGame = this._focusedGame;
            this._focusedGame = this._gameShownAt.has(window) ? window : null;
            // GNOME hands focus back to Big Picture when a game goes fullscreen, and Steam Input follows focus, so the
            // controller would drive the menus behind the game
            const grabbed =
                window.get_title() === BIG_PICTURE_TITLE &&
                previousGame &&
                !previousGame.minimized &&
                GLib.get_monotonic_time() - this._gameShownAt.get(previousGame) < FOCUS_GRAB_WINDOW_MS * 1000;
            if (grabbed && !this._refocusGameId)
                this._refocusGameId = GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
                    this._refocusGameId = 0;
                    if (this._gameShownAt.has(previousGame)) Main.activateWindow(previousGame);
                    return GLib.SOURCE_REMOVE;
                });
        });

        this._windowCreatedId = global.display.connect('window-created', (_display, window) => {
            if (window.get_window_type() !== Meta.WindowType.NORMAL || window.get_transient_for()) return;

            const focused = global.display.focus_window;
            const focusMonitor =
                focused === window
                    ? this._previousFocusMonitor
                    : (focused?.get_monitor() ?? global.display.get_current_monitor());
            const tvMonitor = [mxMaster, 'Logitech MX Keys'].includes(this._deviceName) ? this._tvMonitor() : -1;
            // A display change before the window shows renumbers monitors, so remember the connector, not the index
            const connector = this._connector(tvMonitor >= 0 ? tvMonitor : focusMonitor);

            const clearPending = () => {
                window.disconnect(shownId);
                window.disconnect(unmanagedId);
                this._pendingWindows.delete(window);
            };
            const shownId = window.connect('shown', () => {
                clearPending();
                if (isSteamWindow(window)) {
                    this._keepOnTv(window);
                    // Activating from the shell skips the focus-stealing prevention that leaves Big Picture in front
                    if (isGameWindow(window)) {
                        this._gameShownAt.set(window, GLib.get_monotonic_time());
                        Main.activateWindow(window);
                    }
                    return;
                }
                const monitorIndex = connector
                    ? this._backend.get_monitor_manager().get_monitor_for_connector(connector)
                    : -1;
                if (monitorIndex < 0) return;
                if (!window.get_transient_for() && !window.is_fullscreen() && window.get_monitor() !== monitorIndex)
                    window.move_to_monitor(monitorIndex);
                if (global.display.focus_window === window) this._focusMonitor = window.get_monitor();
            });
            const unmanagedId = window.connect('unmanaged', clearPending);
            this._pendingWindows.set(window, [shownId, unmanagedId]);
        });

        // A display reconfiguration, such as a monitor waking up, can strand Steam windows on the primary BenQ, and the
        // TV only joins the layout once it wakes
        this._monitorsChangedId = Main.layoutManager.connect('monitors-changed', () => {
            if (this._relayoutTimeoutId) GLib.source_remove(this._relayoutTimeoutId);
            this._relayoutTimeoutId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, RELAYOUT_SETTLE_MS, () => {
                this._relayoutTimeoutId = 0;
                for (const window of this._tvWindows.keys()) this._moveToTv(window);
                return GLib.SOURCE_REMOVE;
            });
        });
        // Steam and games under plain Proton place themselves on the primary display after they show: Unity puts its
        // fullscreen window on the display saved as UnitySelectMonitor, and Wine's display 0 is the primary
        this._returnToTvId = 0;
        this._enteredMonitorId = global.display.connect('window-entered-monitor', (_display, _monitorIndex, window) => {
            if (!this._tvWindows.has(window) || this._returnToTvId) return;
            this._returnToTvId = GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
                this._returnToTvId = 0;
                for (const tvWindow of this._tvWindows.keys()) this._moveToTv(tvWindow);
                return GLib.SOURCE_REMOVE;
            });
        });
        for (const window of global.get_window_actors().map((actor) => actor.meta_window))
            if (window?.get_window_type() === Meta.WindowType.NORMAL && isSteamWindow(window)) this._keepOnTv(window);

        for (const name of APP_BINDINGS) {
            Main.wm.setCustomKeybindingHandler(name, Shell.ActionMode.NORMAL, (_display, _window, _event, binding) => {
                Main.wm._workspaceSwitcherPopup?.destroy();
                const popup = new FocusedAppSwitcherPopup();
                if (!popup.show(binding.is_reversed(), binding.get_name(), binding.get_mask())) popup.destroy();
            });
        }
    }

    _connector(monitorIndex) {
        const monitorManager = this._backend.get_monitor_manager();
        return (
            monitorManager
                .get_monitors()
                .find(
                    (monitor) =>
                        monitor.is_active() &&
                        monitorManager.get_monitor_for_connector(monitor.get_connector()) === monitorIndex,
                )
                ?.get_connector() ?? null
        );
    }

    _keepOnTv(window) {
        if (!this._tvWindows.has(window))
            this._tvWindows.set(
                window,
                window.connect('unmanaged', () => {
                    this._tvWindows.delete(window);
                    this._gameShownAt.delete(window);
                }),
            );
        this._moveToTv(window);
    }

    _moveToTv(window) {
        const tvMonitor = this._tvMonitor();
        if (tvMonitor >= 0 && window.get_monitor() !== tvMonitor) window.move_to_monitor(tvMonitor);
    }

    _tvMonitor() {
        const monitorManager = this._backend.get_monitor_manager();
        const monitor = monitorManager
            .get_monitors()
            .find((candidate) => candidate.is_active() && candidate.get_product() === TV_PRODUCT);
        return monitor ? monitorManager.get_monitor_for_connector(monitor.get_connector()) : -1;
    }

    ListWindows() {
        const monitorManager = this._backend.get_monitor_manager();
        const monitors = Array.from({ length: global.display.get_n_monitors() }, (_, index) => `Monitor ${index + 1}`);
        for (const monitor of monitorManager.get_monitors()) {
            if (!monitor.is_active()) continue;
            const index = monitorManager.get_monitor_for_connector(monitor.get_connector());
            if (index < 0) continue;
            const product = monitor.get_product();
            const serial = monitor.get_serial();
            if (monitor.get_vendor() === '{{ .monitors.dummy.vendor }}') monitors[index] = 'Dummy';
            else if (serial === '{{ .monitors.left_benq.serial }}') monitors[index] = 'BenQ Left';
            else if (serial === '{{ .monitors.right_benq.serial }}') monitors[index] = 'BenQ Right';
            else if (product === TV_PRODUCT) monitors[index] = 'LG TV';
            else {
                const model = product?.startsWith('0x') ? monitor.get_vendor() : product;
                monitors[index] = `${monitor.get_connector()} · ${model}`;
            }
        }
        return JSON.stringify({
            windows: global
                .get_window_actors()
                .map((actor) => actor.meta_window)
                .filter((window) => window?.get_window_type() === Meta.WindowType.NORMAL)
                .map((window) => ({
                    id: window.get_id(),
                    title: window.get_title(),
                    app: window.get_wm_class() || 'Unknown app',
                    monitor: monitors[window.get_monitor()],
                })),
        });
    }

    BringToCurrentMonitor(id) {
        const window = global
            .get_window_actors()
            .map((actor) => actor.meta_window)
            .find((candidate) => candidate?.get_id() === id && candidate.get_window_type() === Meta.WindowType.NORMAL);
        if (!window) throw new Error('Window not found');
        window.move_to_monitor(global.display.get_current_monitor());
        Main.activateWindow(window);
    }

    ShowOnTv(title) {
        const window = global
            .get_window_actors()
            .map((actor) => actor.meta_window)
            .find(
                (candidate) =>
                    candidate?.get_title() === title && candidate.get_window_type() === Meta.WindowType.NORMAL,
            );
        const tvMonitor = this._tvMonitor();
        // The TV takes a few seconds to appear after waking, and steam-tv keeps asking until this succeeds
        if (!window || tvMonitor < 0) return false;
        this._keepOnTv(window);
        // Activating from the shell skips the focus-stealing prevention that holds back windows from background units
        Main.activateWindow(window);
        return true;
    }

    disable() {
        this._windowService.unexport();
        this._windowService = null;
        this._backend.disconnect(this._deviceChangedId);
        global.display.disconnect(this._focusChangedId);
        global.display.disconnect(this._windowCreatedId);
        for (const [window, signalIds] of this._pendingWindows)
            for (const signalId of signalIds) window.disconnect(signalId);
        this._pendingWindows = null;
        Main.layoutManager.disconnect(this._monitorsChangedId);
        if (this._relayoutTimeoutId) GLib.source_remove(this._relayoutTimeoutId);
        global.display.disconnect(this._enteredMonitorId);
        if (this._returnToTvId) GLib.source_remove(this._returnToTvId);
        if (this._refocusGameId) GLib.source_remove(this._refocusGameId);
        this._focusedGame = null;
        for (const [window, unmanagedId] of this._tvWindows) window.disconnect(unmanagedId);
        this._tvWindows = null;
        this._gameShownAt = null;
        this._backend = null;

        for (const name of APP_BINDINGS)
            Main.wm.setCustomKeybindingHandler(name, Shell.ActionMode.NORMAL, Main.wm._startSwitcher.bind(Main.wm));
    }
}

const FocusedAppSwitcherPopup = GObject.registerClass(
    class FocusedAppSwitcherPopup extends AltTab.AppSwitcherPopup {
        _init() {
            super._init();
            this._monitorIndex = global.display.focus_window?.get_monitor() ?? global.display.get_current_monitor();
        }

        vfunc_allocate(box) {
            // GNOME Shell uses the primary monitor for both icon and thumbnail allocation.
            this.set_allocation(box);

            const monitor = Main.layoutManager.monitors[this._monitorIndex] ?? Main.layoutManager.primaryMonitor;
            const themeNode = this.get_theme_node();
            const leftPadding = themeNode.get_padding(St.Side.LEFT);
            const rightPadding = themeNode.get_padding(St.Side.RIGHT);
            const hPadding = leftPadding + rightPadding;
            const childBox = new Clutter.ActorBox();
            const [, height] = this._switcherList.get_preferred_height(monitor.width - hPadding);
            const [, width] = this._switcherList.get_preferred_width(height);

            childBox.x1 = Math.max(monitor.x + leftPadding, monitor.x + Math.floor((monitor.width - width) / 2));
            childBox.x2 = Math.min(monitor.x + monitor.width - rightPadding, childBox.x1 + width);
            childBox.y1 = monitor.y + Math.floor((monitor.height - height) / 2);
            childBox.y2 = childBox.y1 + height;
            this._switcherList.allocate(childBox);

            if (!this._thumbnails) return;

            const icon = this._items[this._selectedIndex];
            const [iconX] = icon.get_transformed_position();
            const thumbnailCenter = iconX + icon.width / 2;
            const [, thumbnailWidth] = this._thumbnails.get_preferred_width(-1);
            childBox.x1 = Math.max(monitor.x + leftPadding, Math.floor(thumbnailCenter - thumbnailWidth / 2));
            if (childBox.x1 + thumbnailWidth > monitor.x + monitor.width - hPadding) {
                const offset = childBox.x1 + thumbnailWidth - monitor.width + hPadding;
                childBox.x1 = Math.max(monitor.x + leftPadding, childBox.x1 - offset - hPadding);
            }

            childBox.x2 = Math.min(childBox.x1 + thumbnailWidth, monitor.x + monitor.width - rightPadding);
            childBox.y1 = this._switcherList.allocation.y2 + themeNode.get_length('spacing');
            this._thumbnails.addClones(
                monitor.y + monitor.height - themeNode.get_padding(St.Side.BOTTOM) - childBox.y1,
            );
            const [, thumbnailHeight] = this._thumbnails.get_preferred_height(-1);
            childBox.y2 = childBox.y1 + thumbnailHeight;
            this._thumbnails.allocate(childBox);
        }
    },
);
