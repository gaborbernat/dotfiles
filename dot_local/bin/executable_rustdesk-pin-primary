#!/usr/bin/python3
"""Keep RustDesk's Wayland screencast restore token on the HDMI dummy plug, or the primary monitor without it."""

import logging
import time
import tomllib
from pathlib import Path
from typing import Final

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # ruff: ignore[module-import-not-at-top-of-file] # require_version must run first

_CONFIG: Final = Path.home() / ".config/rustdesk/RustDesk_local.toml"
_MUTTER: Final = ("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig")
_STORE: Final = (
    "org.freedesktop.impl.portal.PermissionStore",
    "/org/freedesktop/impl/portal/PermissionStore",
    "org.freedesktop.impl.portal.PermissionStore",
)
_PREFERRED: Final = "FUE:0x2160:0x6f35b130"
_LOG: Final = logging.getLogger("rustdesk-pin-primary")


def main() -> None:
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    bus: Final = Gio.bus_get_sync(Gio.BusType.SESSION)
    # xdg-desktop-portal deletes a restore token from the permission store once it is used, and GNOME rejects one that
    # names a missing monitor, so a single connection with a monitor unplugged would lose the selection for good
    bus.signal_subscribe(
        _MUTTER[0], _MUTTER[2], "MonitorsChanged", _MUTTER[1], None, Gio.DBusSignalFlags.NONE, lambda *_: pin(bus)
    )
    # When a session ends the portal writes the session's original selection back to the store
    bus.signal_subscribe(
        _STORE[0], _STORE[2], "Changed", _STORE[1], "screencast", Gio.DBusSignalFlags.NONE, lambda *_: pin(bus)
    )
    pin(bus)
    GLib.MainLoop().run()


def pin(bus: Gio.DBusConnection) -> None:
    if not (token := restore_token()):
        _LOG.info("no restore token in %s yet, pick a screen in RustDesk once", _CONFIG)
        return
    if (match := target_match_string(bus)) is None:
        _LOG.info("neither %s nor a primary monitor is connected", _PREFERRED)
        return
    if stored_match_strings(bus, token) == [match]:
        return
    now: Final = time.time_ns() // 1000
    # Source type 1 is a monitor
    streams: Final = [(0, 1, GLib.Variant("s", match))]
    data: Final = GLib.Variant("(suv)", ("GNOME", 1, GLib.Variant("(xxa(uuv))", (now, now, streams))))
    # The empty app ID grants the permission to host (non-sandboxed) apps
    args: Final = GLib.Variant("(sbsa{sas}v)", ("screencast", True, token, {"": ["yes"]}, data))
    call(bus, _STORE, "Set", args)
    _LOG.info("pinned restore token to %s", match)


def restore_token() -> str:
    try:
        return tomllib.loads(_CONFIG.read_text())["options"].get("wayland-restore-token", "")
    except (FileNotFoundError, KeyError, tomllib.TOMLDecodeError) as exc:
        _LOG.warning("cannot read %s: %r", _CONFIG, exc)
        return ""


def target_match_string(bus: Gio.DBusConnection) -> str | None:
    _, _, logical_monitors, _ = call(bus, _MUTTER, "GetCurrentState", None).unpack()
    matches: Final = {match_string(*monitors[0]): primary for _, _, _, _, primary, monitors, _ in logical_monitors}
    if _PREFERRED in matches:
        return _PREFERRED
    return next((match for match, primary in matches.items() if primary), None)


def call(bus: Gio.DBusConnection, target: tuple[str, str, str], method: str, args: GLib.Variant | None) -> GLib.Variant:
    return bus.call_sync(target[0], target[1], target[2], method, args, None, Gio.DBusCallFlags.NONE, -1, None)


def match_string(connector: str, vendor: str, product: str, serial: str) -> str:
    # Mirrors xdg-desktop-portal-gnome's displaystatetracker.c match string
    return connector if vendor == product == serial == "unknown" else f"{vendor}:{product}:{serial}"


def stored_match_strings(bus: Gio.DBusConnection, token: str) -> list[str] | None:
    try:
        _, data = call(bus, _STORE, "Lookup", GLib.Variant("(ss)", ("screencast", token))).unpack()
    except GLib.Error as exc:
        if Gio.DBusError.get_remote_error(exc) != "org.freedesktop.portal.Error.NotFound":
            raise
        return None
    _, _, (_, _, streams) = data
    return [stream_data for _, _, stream_data in streams]


if __name__ == "__main__":
    main()
