#!/bin/bash
set -euo pipefail

YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

if [[ ! -f "package.json" ]]; then
  echo -e "${YELLOW}Error:${RESET} package.json not found in the current directory."
  exit 1
fi

printf "${BOLD}%-20s %s${RESET}\n" "Script" "Command"
printf "${BOLD}%-20s %s${RESET}\n" "------" "-------"

node - <<'EOF'
const scripts = require('./package.json').scripts;
const grouped = {};
for (const [key, command] of Object.entries(scripts)) {
  const hook = ['pre', 'post'].find(prefix => key.startsWith(prefix) && scripts[key.slice(prefix.length)]);
  const base = hook ? key.slice(hook.length) : key;
  (grouped[base] ??= {})[hook ?? ''] = command;
}
for (const base of Object.keys(grouped).sort()) {
  for (const hook of ['pre', '', 'post']) {
    const command = grouped[base][hook];
    if (command)
      console.log(`\x1b[1;33m${(hook + base).padEnd(20)}\x1b[0m \x1b[0;36m${command}\x1b[0m`);
  }
}
EOF
