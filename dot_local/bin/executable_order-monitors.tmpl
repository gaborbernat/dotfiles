#!/usr/bin/python3
"""Keep connected GNOME displays in the configured left-to-right order, with the right one primary."""

import logging
from typing import Any, Final

from gnome_dbus import MUTTER, Gio, GLib, call

_TV_RANK: Final = 3


def main() -> None:
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    bus: Final = Gio.bus_get_sync(Gio.BusType.SESSION)

    def on_monitors_changed(*_: object) -> None:
        GLib.timeout_add(500, arrange, bus)

    bus.signal_subscribe(
        MUTTER.name,
        MUTTER.interface,
        "MonitorsChanged",
        MUTTER.path,
        None,
        Gio.DBusSignalFlags.NONE,
        on_monitors_changed,
    )
    arrange(bus)
    GLib.MainLoop().run()


def arrange(bus: Gio.DBusConnection) -> bool:
    log: Final = logging.getLogger("order-monitors")
    try:
        state: Final = call(bus, MUTTER, "GetCurrentState", None).unpack()
    except GLib.Error:
        log.exception("could not read displays")
        return GLib.SOURCE_REMOVE
    serial, monitors, logical_monitors, properties = state
    if (layout := desired_layout(monitors, logical_monitors)) is None:
        return GLib.SOURCE_REMOVE
    config_properties: Final = {
        key: properties[key] for key in ("layout-mode", "monitors-for-lease") if key in properties
    }
    try:
        for method in (0, 2):
            call(
                bus,
                MUTTER,
                "ApplyMonitorsConfig",
                GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, method, layout, config_properties)),
            )
    except GLib.Error:
        log.exception("could not order displays")
        return GLib.SOURCE_REMOVE
    log.info(
        "ordered displays: %s (primary %s)",
        " → ".join(logical[5][0][0] for logical in layout),
        next(logical[5][0][0] for logical in layout if logical[4]),
    )
    return GLib.SOURCE_REMOVE


def desired_layout(monitors: list[Any], logical_monitors: list[Any]) -> list[tuple[Any, ...]] | None:
    if len(logical_monitors) < 2 or any(len(logical[5]) != 1 for logical in logical_monitors):
        return None

    modes: Final = {
        spec[0]: (current_mode, monitor_properties)
        for spec, available_modes, monitor_properties in monitors
        if (current_mode := next((mode for mode in available_modes if "is-current" in mode[6]), None))
    }

    ranked: Final = [(rank(logical[5][0]), logical[5][0][0], logical) for logical in logical_monitors]
    if any(connector not in modes for _, connector, _ in ranked):
        return None

    # Steam and games open on the primary display: desk work keeps the left BenQ, otherwise the TV takes over
    primary: Final = next((connector for wanted in (1, _TV_RANK) for r, connector, _ in ranked if r == wanted), None)
    primaries: Final = {connector: connector == primary if primary else logical[4] for _, connector, logical in ranked}
    current: Final = sorted(ranked, key=lambda item: item[2][0])
    # An unrecognized display has no slot in the order, so keep everyone in place and only fix the primary
    reorder: Final = all(r >= 0 for r, _, _ in ranked)
    target: Final = sorted(ranked) if reorder else current
    if target == current and all(logical[4] == primaries[connector] for _, connector, logical in ranked):
        return None

    position = 0
    layout: Final[list[tuple[Any, ...]]] = []
    for _, connector, logical in target:
        mode, monitor_properties = modes[connector]
        layout.append((
            position if reorder else logical[0],
            logical[1],
            logical[2],
            logical[3],
            primaries[connector],
            [
                (
                    connector,
                    mode[0],
                    {key: monitor_properties[key] for key in ("color-mode", "rgb-range") if key in monitor_properties},
                )
            ],
        ))
        width, height = mode[1:3]
        position += round((height if logical[3] in {1, 3, 5, 7} else width) / logical[2])
    return layout


def rank(spec: tuple[str, str, str, str]) -> int:
    _, vendor, product, monitor_serial = spec
    if vendor == "{{ .monitors.dummy.vendor }}":
        return 0
    return {"{{ .monitors.left_benq.serial }}": 1, "{{ .monitors.right_benq.serial }}": 2}.get(monitor_serial, _TV_RANK if product == "{{ .monitors.tv.product }}" else -1)


if __name__ == "__main__":
    main()
