#!/bin/bash
# Print the default sink or source; with "next", switch to the following one first.
set -euo pipefail

kind=${1:?usage: audio-cycle sink|source [next]}
devices() {
    # pactl's JSON output turns non-ASCII descriptions such as "RØDE PodMic" into "(null)", so read the plain listing;
    # LC_ALL=C keeps its field labels in English
    LC_ALL=C pactl list "${kind}s" |
        awk '/^\tName: / { name = substr($0, 8) }
            /^\tDescription: / && name !~ /\.monitor$|^bluez_input/ { print name "\t" substr($0, 15) }'
}

listing=$(devices)
current=$(pactl "get-default-${kind}")
if [[ ${2-} == next ]]; then
    names=()
    while IFS=$'\t' read -r name _; do
        names+=("${name}")
    done <<<"${listing}"
    next=0
    for index in "${!names[@]}"; do
        [[ ${names[index]} == "${current}" ]] && next=$(((index + 1) % ${#names[@]}))
    done
    current=${names[next]}
    pactl "set-default-${kind}" "${current}"
fi
awk -F '\t' -v name="${current}" '$1 == name { print $2 }' <<<"${listing}"
