#!/usr/bin/bash
set -euo pipefail

fail() {
    printf '%s\n' "$1" >&2
    /usr/bin/notify-send --app-name=Steam 'Steam on TV' "$1"
    exit 1
}

if steam_pid=$(/usr/bin/pgrep --ignore-ancestors --uid "$UID" --exact steam); then
    if ! /usr/bin/rg --text --null-data --quiet '^GAMESCOPE_WAYLAND_DISPLAY=.' "/proc/$steam_pid/environ"; then
        fail 'Steam is already running outside TV mode. Exit Steam, then open it again.'
    fi
    if (( $# == 0 )); then
        exec /usr/bin/steam steam://open/bigpicture
    fi
    exec /usr/bin/steam "$@"
fi

if ! monitor=$(/usr/bin/xrandr --listmonitors | /usr/bin/awk '$NF == "HDMI-1" {sub(/:$/, "", $1); print $1}'); then
    fail 'Cannot read the connected displays. Start Steam from your desktop session.'
fi
if [[ -z "$monitor" ]]; then
    fail 'The TV on HDMI-1 is unavailable. Connect and enable it, then open Steam again.'
fi

exec /usr/bin/env SDL_VIDEODRIVER=x11 /usr/bin/gamescope \
    --backend sdl --display-index "$monitor" \
    -w 3840 -h 2160 -W 3840 -H 2160 -r 60 -f -e --mangoapp \
    -- /usr/bin/env -u WAYLAND_DISPLAY -u SDL_VIDEODRIVER /usr/bin/steam -gamepadui "$@"
