#!/bin/bash
# ~/.cargo is often a symlink to an external volume. A chezmoi-managed dot_cargo/
# would replace that symlink with a real directory, so the config is written
# through it instead.
set -euo pipefail

mkdir -p "$HOME/.cargo"
cat >"$HOME/.cargo/config.toml" <<'CARGO_CONFIG'
{{ template "cargo-config.toml.tmpl" . -}}
CARGO_CONFIG
echo "✅ cargo config written"
