<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A Bluetooth headset that reconnects becomes the default mic, and any app
     opening it drops playback to the hands-free profile. Move the default
     back to a wired mic whenever a device arrives. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gaborbernat.audio-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/deck-helper</string>
        <string>guard</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
