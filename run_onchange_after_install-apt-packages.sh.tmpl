{{- if ne (env "SKIP_APT_INSTALL") "1" -}}
#!/bin/bash
# apt packages hash: {{ include "dot_apt_packages.txt" | sha256sum }}
set -euo pipefail

if ! command -v apt-get >/dev/null 2>&1; then
    echo "apt-get is required to install the package manifest" >&2
    exit 1
fi

mapfile -t packages < <(grep -vE '^\s*(#|$)' "$HOME/.apt_packages.txt")

echo "📦 Installing apt packages (sudo required)..."
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"

# Debian and Ubuntu name fd-find's binary fdfind to avoid a clash; link it as fd, the name other platforms and this
# repo use.
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

echo "✅ apt packages installed"
{{ end -}}
