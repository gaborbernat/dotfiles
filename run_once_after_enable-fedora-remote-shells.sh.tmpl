{{- if ne (env "SKIP_FEDORA_REMOTE_SHELLS") "1" -}}
#!/bin/bash
set -euo pipefail

# Keys only, once a key is authorized: a password prompt on an open port invites guessing. sshd keeps the first value
# it reads, so 40- sorts ahead of Fedora's 50-redhat.conf.
if [[ -s "${HOME}/.ssh/authorized_keys" ]]; then
    sudo install --mode=0600 /dev/stdin /etc/ssh/sshd_config.d/40-keys-only.conf <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
EOF
    sudo sshd -t
else
    echo "No ~/.ssh/authorized_keys yet; sshd keeps password logins until one is added and this script reruns" >&2
fi

# Both clients authenticate over SSH; ET also keeps a TCP listener, while
# Mosh starts a per-session UDP listener on demand.
sudo systemctl enable --now sshd.service et.service
sudo systemctl reload sshd.service

if systemctl is-active --quiet firewalld.service; then
    zone=$(firewall-cmd --get-default-zone)
    sudo firewall-cmd --permanent --zone="${zone}" --add-service=ssh
    sudo firewall-cmd --permanent --zone="${zone}" --add-port=2022/tcp
    sudo firewall-cmd --permanent --zone="${zone}" --add-port=60000-61000/udp
    sudo firewall-cmd --reload
fi

echo "SSH and Eternal Terminal servers enabled; Mosh is ready for SSH-initiated sessions"
{{ end -}}
