{{- if and (eq .chezmoi.os "linux") (eq (get .chezmoi.osRelease "id") "fedora") -}}
#!/bin/bash
set -euo pipefail

source_dir=$(mktemp -d)
trap 'rm -rf "$source_dir"' EXIT

git clone --no-checkout -q https://github.com/perrin-g/whisper-dictation.git "$source_dir"
git -C "$source_dir" checkout -q 7caa9f0b4d3315b4d3288c93a6cacaf7207a37f9
WD_SKIP_PKGS=1 WD_PY=/usr/bin/python3 XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME \
	bash "$source_dir/install.sh"

schema=org.gnome.settings-daemon.plugins.media-keys
bindings=$(gsettings get "$schema" custom-keybindings)
while IFS= read -r path; do
	binding="$schema.custom-keybinding:$path"
	if [[ $(gsettings get "$binding" name) == "'Whisper Dictation'" ]]; then
		gsettings set "$binding" binding '<Super>d'
		exit 0
	fi
done < <(grep -oE '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom[0-9]+/' <<<"$bindings")

echo 'Whisper Dictation shortcut was not installed' >&2
exit 1
{{ else -}}
#!/bin/sh
exit 0
{{ end -}}
