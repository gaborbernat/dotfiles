{
  "cleanupPeriodDays": 14,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
{{- range $command := .agent_commands.shared }}
{{-   range $subcommand := get $.agent_commands.claude_subcommands $command | default (list "") }}
      "Bash({{ $command }}{{ if $subcommand }} {{ $subcommand }}{{ end }} *)",
{{-   end }}
{{- end }}
      "Bash(.tox/*/bin/python -m pytest *)",
      "Bash(.tox/*/bin/python -m pytest)",
      "Bash(command -v *)",
      "Bash(dig:*)",
      "Bash(scutil --get *)",
      "Bash(bun --version)",
      "Bash(npm --version)",
      "Bash(ccstatusline --version)",
      "Bash(python3 -m json.tool)",
      "Bash(uv run {{ .chezmoi.homeDir }}/.claude/skills/no-slop/scripts/slop_score.py*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(claude-in-chrome)",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": {{ output "sh" "-c" `jq -r '.model // "opus[1m]"' "$HOME/.claude/settings.json" 2>/dev/null || echo 'opus[1m]'` | trim | quote }},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh SessionStart '✨'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prune-versions.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh SessionEnd '👋'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh UserPromptSubmit '🏃'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh PermissionRequest '❓'{{ if ne .chezmoi.hostname "pc" }} permission.aiff{{ end }}"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh PreToolUse '🏃'"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh Notification '❗'{{ if ne .chezmoi.hostname "pc" }} waiting.aiff{{ end }}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh Stop '💤'{{ if ne .chezmoi.hostname "pc" }} complete.aiff{{ end }}"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
