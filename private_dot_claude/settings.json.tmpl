{
  "cleanupPeriodDays": 14,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(command -v *)",
      "Bash(dig:*)",
      "Bash(scutil --get *)",
      "Bash(bun --version)",
      "Bash(npm --version)",
      "Bash(ccstatusline --version)",
      "Bash(python3 -m json.tool)",
      "Bash(uv run {{ .chezmoi.homeDir }}/.claude/skills/no-slop/scripts/slop_score.py*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(claude-in-chrome)",
      "WebSearch"
    ],
    "ask": [
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue comment *)",
      "Bash(gh api repos/*/comments*)",
      "Bash(gh api repos/*/reviews*)",
      "Bash(gh api repos/*/replies*)"
    ],
    "defaultMode": "auto"
  },
  "model": {{ output "sh" "-c" `jq -r '.model // "opus"' "$HOME/.claude/settings.json" 2>/dev/null || echo 'opus'` | trim | quote }},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh SessionStart '✨'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prune-versions.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh SessionEnd '👋'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh UserPromptSubmit '🏃'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh PermissionRequest '❓'{{ if ne .chezmoi.hostname "pc" }} permission.aiff{{ end }}"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh PreToolUse '🏃'"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/filter-test-output.py rewrite"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh Notification '❗'{{ if ne .chezmoi.hostname "pc" }} waiting.aiff{{ end }}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh Stop '💤'{{ if ne .chezmoi.hostname "pc" }} complete.aiff{{ end }}"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "idleCompaction": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  }{{- $auto := joinPath .chezmoi.homeDir ".local/share/chezmoi-private/claude_auto_mode.json" }}{{ if stat $auto }},
  "autoMode": {{ output "cat" $auto }}{{ end }}
}
