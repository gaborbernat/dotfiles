{{- if ne (env "SKIP_DOCKER_ENABLE") "1" -}}
#!/bin/bash
set -euo pipefail

if ! command -v systemctl >/dev/null 2>&1 ||
    ! systemctl list-unit-files docker.service --no-legend 2>/dev/null | grep -q '^docker.service'; then
    echo "docker.service is required before enabling Docker" >&2
    exit 1
fi

sudo systemctl enable --now docker.service
user=$(id -un)
sudo usermod -aG docker "${user}"
echo "Docker service enabled and started"
{{ end -}}
